---
// src/pages/[city]/bunbetsu/[item]/index.astro
//
// 品目別ページ（SEO・分別検索対応の試作／2026-08-21）。
// 「志木市 電池 捨て方」のような検索から直接着地できるよう、品目ごとに
// 実URLを発行する。既存の分別検索アプリ（[city]/index.astro）のUX・挙動は
// 一切変更しない。完全に独立した、軽量で読み込みの速いコンテンツページとして
// 追加し、記事ページ（ArticleLayout）と同じ見た目の言語を踏襲している。
//
// 重複・薄いコンテンツ対策: 品目固有のメモ・タグに加え、その自治体での
// そのカテゴリの出し方・許容/不可リスト・コツ（data_{city}.jsonのcategoriesに
// 実データとして存在し、自治体ごとに内容が異なる）を組み合わせて表示することで、
// 「都市名だけ違うテンプレページ」にならないようにしている。
//
// 【試作段階】太平さんの確認が済むまでは、getStaticPathsを一部の品目に限定している
// （下記 PROTOTYPE_WHITELIST）。確認後、フィルタを外せば全品目（873件）に展開できる。
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getAllCityItemData, sanitizeAppHtml, CATEGORY_STYLE, type GarbageItem } from '../../../../lib/itemPages';

export async function getStaticPaths() {
  // 【試作段階のみ】太平さんの確認後、このフィルタを削除して全品目に展開する。
  const PROTOTYPE_WHITELIST = new Set([
    'shiki::生ごみ', 'shiki::モバイルバッテリー', 'shiki::テレビ（液晶・有機EL）',
    'shiki::布団', 'shiki::使い捨てマスク',
    'warabi::アイスノン（氷枕）', 'warabi::アイパッド', 'warabi::衣類乾燥機', 'warabi::IHコンロ',
  ]);
  const cities = getAllCityItemData();
  const paths: { params: { city: string; item: string }; props: Record<string, unknown> }[] = [];
  for (const city of cities) {
    for (const item of city.garbage_db) {
      if (!PROTOTYPE_WHITELIST.has(`${city.municipality_id}::${item.name}`)) continue;
      paths.push({
        params: { city: city.municipality_id, item: item.name },
        props: { city, item },
      });
    }
  }
  return paths;
}

const { city, item } = Astro.props as { city: Awaited<ReturnType<typeof getAllCityItemData>>[number]; item: GarbageItem };
const cat = city.categories[item.category] ?? { label: item.category };
const style = CATEGORY_STYLE[item.category] ?? CATEGORY_STYLE.unknown;
const cityPath = `/${city.municipality_id}/`;
const canonicalPath = `/${city.municipality_id}/bunbetsu/${encodeURIComponent(item.name)}/`;
const canonicalUrl = new URL(canonicalPath, 'https://gomi-nico.jp').toString();
const primaryContact = city.contact?.[0];

const title = `${item.name}は${cat.label}｜${city.name}のごみ分別`;
const description = `${city.name}で「${item.name}」を捨てるときは${cat.label}です。${item.note ?? cat.how ?? ''}`.slice(0, 110);

const answerText = [item.note, cat.how ? cat.how.replace(/<[^>]+>/g, '') : null]
  .filter(Boolean)
  .join(' ');

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'QAPage',
      mainEntity: {
        '@type': 'Question',
        name: `${city.name}で${item.name}は何ごみ？`,
        text: `${city.name}で${item.name}を捨てるときの分別区分と出し方を知りたい`,
        answerCount: 1,
        acceptedAnswer: {
          '@type': 'Answer',
          text: answerText || cat.label,
        },
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'ごみニコ', item: 'https://gomi-nico.jp/' },
        { '@type': 'ListItem', position: 2, name: `${city.name}のごみ分別`, item: new URL(cityPath, 'https://gomi-nico.jp').toString() },
        { '@type': 'ListItem', position: 3, name: item.name, item: canonicalUrl },
      ],
    },
  ],
};

const howHtml = cat.how ? sanitizeAppHtml(cat.how, cityPath, primaryContact?.tel) : null;
const tipsHtml = (cat.tips ?? []).map((t) => sanitizeAppHtml(t, cityPath, primaryContact?.tel));
---
<BaseLayout title={`${title} | ごみニコ`} description={description} canonicalPath={canonicalPath} jsonLd={jsonLd} city={city.municipality_id}>
  <header class="bg-white border-b border-black/[0.07] sticky top-0 z-10">
    <div class="max-w-2xl mx-auto px-5 py-4 flex items-center gap-3">
      <a href={cityPath} class="text-[#00A86B] font-bold text-sm no-underline">← {city.name}のごみ分別アプリ</a>
    </div>
  </header>

  <main class="bg-white max-w-2xl mx-auto px-5 pt-8 pb-20">
    <nav aria-label="パンくずリスト" class="mb-4">
      <ol class="flex flex-wrap items-center gap-1" style="font-size:12px;color:var(--muted);list-style:none;padding:0;margin:0">
        <li><a href="/" class="no-underline" style="color:var(--muted)">ごみニコ</a></li>
        <li aria-hidden="true">›</li>
        <li><a href={cityPath} class="no-underline" style="color:var(--muted)">{city.name}</a></li>
        <li aria-hidden="true">›</li>
        <li aria-current="page" style="color:var(--ink);font-weight:700">{item.name}</li>
      </ol>
    </nav>

    <article>
      <div class="flex items-center gap-2 mb-3">
        <span class="tag-chip" style={`background:${style.bg};color:${style.fg};display:inline-flex;align-items:center;gap:6px;border-radius:999px;padding:6px 14px;font-size:13px;font-weight:700`}>
          <span class="ms-o" style="font-size:15px">{style.icon}</span>{cat.label}
        </span>
      </div>
      <h1 class="mb-5" style="font-family:'Zen Kaku Gothic New',sans-serif;font-size:23px;font-weight:900;color:var(--ink);line-height:1.5;letter-spacing:-.01em">
        {item.name}は{cat.label}｜{city.name}
      </h1>

      {item.note && (
        <div class="rounded-2xl shadow-sm px-5 py-5 mb-6" style="background:var(--bg-neutral-soft)">
          <h2 class="text-[13px] font-extrabold mb-2" style="color:var(--muted);letter-spacing:.06em">出し方・注意点</h2>
          <p style="font-size:16px;color:var(--ink);line-height:1.8;margin:0">{item.note}</p>
        </div>
      )}

      {item.source === 'estimated' && (
        <div class="flex items-start gap-2 mb-6 rounded-xl px-4 py-3" style="background:var(--bg-neutral-soft);border:1px dashed rgba(0,0,0,0.15)">
          <span class="ms-o" style="font-size:16px;color:var(--muted);flex-shrink:0;line-height:1.5">info</span>
          <p style="font-size:12.5px;color:var(--muted);line-height:1.7;margin:0">
            {city.name}の公式資料に記載がないため、一般的な分別ルールをもとにした参考情報です。正式な確認は下記の問い合わせ先へご連絡ください。
          </p>
        </div>
      )}

      {howHtml && (
        <div class="rounded-2xl shadow-sm px-5 py-5 mb-6" style="background:#F3FAF6;border-left:4px solid #00A86B">
          <h2 class="text-[13px] font-extrabold mb-2" style="color:#00885A;letter-spacing:.06em">{cat.label}の出し方（{city.name}）</h2>
          <p style="font-size:15px;color:#4B4B4D;line-height:1.8;margin:0" set:html={howHtml} />
        </div>
      )}

      {cat.how_steps && cat.how_steps.length > 0 && (
        <div class="mb-6">
          <h2 class="text-[13px] font-extrabold mb-3" style="color:var(--ink);letter-spacing:.06em">手順</h2>
          <ol class="flex flex-col gap-2">
            {cat.how_steps.map((step, i) => (
              <li class="flex items-start gap-3" style="font-size:15px;color:#4B4B4D;line-height:1.7">
                <span style="flex-shrink:0;width:22px;height:22px;border-radius:50%;background:var(--bg-neutral-soft);color:var(--text);font-size:12px;font-weight:700;display:flex;align-items:center;justify-content:center;margin-top:2px">{i + 1}</span>
                <span set:html={sanitizeAppHtml(step, cityPath, primaryContact?.tel)} />
              </li>
            ))}
          </ol>
        </div>
      )}

      {cat.allowed && cat.allowed.length > 0 && (
        <div class="mb-6">
          <h2 class="text-[13px] font-extrabold mb-3" style="color:var(--ink);letter-spacing:.06em">{cat.label}として出せるものの例</h2>
          <ul class="flex flex-col gap-2">
            {cat.allowed.slice(0, 8).map((a) => (
              <li class="flex items-start gap-2" style="font-size:14.5px;color:#4B4B4D;line-height:1.7">
                <span class="ms" style="font-size:15px;color:#00A86B;flex-shrink:0;margin-top:2px">check_circle</span>
                {a}
              </li>
            ))}
          </ul>
        </div>
      )}

      {tipsHtml.length > 0 && (
        <div class="rounded-2xl shadow-sm px-5 py-5 mb-6" style="background:#F0F2F5">
          <h2 class="text-[13px] font-extrabold mb-3" style="color:var(--ink);letter-spacing:.06em">コツ・注意点</h2>
          <ul class="flex flex-col gap-2">
            {tipsHtml.map((t) => (
              <li style="font-size:14.5px;color:#4B4B4D;line-height:1.8" set:html={t} />
            ))}
          </ul>
        </div>
      )}

      {item.tags && item.tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-8">
          {item.tags.map((t) => (
            <span style="display:inline-flex;align-items:center;background:#F0F2F5;color:#4B4B4D;border-radius:999px;padding:6px 14px;font-size:13px;font-weight:700">#{t}</span>
          ))}
        </div>
      )}

      <a href={`${cityPath}?open=${item.category}`}
         class="flex items-center justify-center gap-2 no-underline mb-4"
         style={`height:52px;background:${style.fg};color:#fff;border-radius:14px;font-size:15px;font-weight:700`}>
        {cat.label}の詳細をアプリで見る<span class="ms" style="font-size:18px">arrow_forward</span>
      </a>

      {primaryContact && (
        <div class="rounded-2xl shadow-sm px-5 py-5 mb-10" style="background:var(--bg-neutral-soft)">
          <h2 class="text-[13px] font-extrabold mb-2" style="color:var(--muted);letter-spacing:.06em">お問い合わせ</h2>
          <p style="font-size:15px;font-weight:700;color:var(--ink);margin:0 0 4px">{primaryContact.name}</p>
          {primaryContact.note && <p style="font-size:13px;color:var(--muted);margin:0 0 8px">{primaryContact.note}</p>}
          <div class="flex items-center gap-4 flex-wrap">
            {primaryContact.tel && (
              <a href={`tel:${primaryContact.tel}`} class="no-underline" style="color:#00885A;font-weight:700;font-size:14px">
                📞 {primaryContact.tel}
              </a>
            )}
            {primaryContact.hours && <span style="font-size:13px;color:var(--muted)">{primaryContact.hours}</span>}
          </div>
        </div>
      )}

      <div class="mb-10">
        <h2 class="text-[15px] font-extrabold text-[var(--ink)] mb-3" style="letter-spacing:.08em">こんなページも</h2>
        <div class="flex flex-col gap-3">
          <a href={cityPath} class="flex items-center gap-3 rounded-2xl shadow-sm px-5 py-4 no-underline" style="min-height:44px;background:#F0F2F5">
            <span class="ms" style="font-size:22px;color:#00A86B;flex-shrink:0">calendar_month</span>
            <div>
              <p class="text-[15px] font-bold text-[var(--ink)]">{city.name}のごみ収集日を確認する</p>
              <p class="text-[14px]" style="color:var(--muted)">カレンダーで今日・明日の収集日がわかります</p>
            </div>
            <span class="ms-o ml-auto" style="font-size:20px;color:var(--muted);flex-shrink:0">chevron_right</span>
          </a>
          <a href="/articles/" class="flex items-center gap-3 rounded-2xl shadow-sm px-5 py-4 no-underline" style="min-height:44px;background:#F0F2F5">
            <span class="ms" style="font-size:22px;color:#00A86B;flex-shrink:0">menu_book</span>
            <div>
              <p class="text-[15px] font-bold text-[var(--ink)]">記事一覧を見る</p>
              <p class="text-[14px]" style="color:var(--muted)">ごみの困りごとを解決する記事をもっと読む</p>
            </div>
            <span class="ms-o ml-auto" style="font-size:20px;color:var(--muted);flex-shrink:0">chevron_right</span>
          </a>
        </div>
      </div>
    </article>
  </main>
</BaseLayout>
