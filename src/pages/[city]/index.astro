---
// src/pages/[city]/index.astro
//
// 自治体アプリ本体ページ（/{city}/）のデータ駆動化（Astro移行フェーズ3）。
// 実際のレンダリングは src/lib/renderCityPage.ts に共通化してある
// （src/pages/preview-city/[city]/index.astro と同じロジックを使う）。
//
// 【重要】public/{city}/index.html が既に存在する自治体（現状は志木市・
// 蕨市）は、このページとファイル名が衝突するため、Astro のビルドが
// 自動的にこちらの生成をスキップし、既存の静的ファイルがそのまま
// 使われる（Astro標準の安全動作）。つまり現時点ではこのページは
// "待機中" で、本番の表示には影響しない。中身の見た目を確認したい
// 場合は src/pages/preview-city/[city]/index.astro のプレビュー版を見ること。
import { getAllCityData, renderCityPage } from '../../lib/renderCityPage';

export async function getStaticPaths() {
  return getAllCityData().map((data) => ({
    params: { city: data.municipality_id },
    props: { data },
  }));
}

const { data } = Astro.props;
const fullHtml = renderCityPage(data);
---
<Fragment set:html={fullHtml} />
