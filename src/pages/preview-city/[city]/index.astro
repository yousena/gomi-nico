---
// src/pages/preview-city/[city]/index.astro
//
// 太平さん確認用のプレビューページ。/preview-city/{city}/ という、
// public/配下の既存ファイルと絶対に衝突しないURLに配置しているため、
// 本番の /{city}/ とは無関係に必ず新しい仕組み（Astro移行フェーズ3）の
// 結果をそのまま表示できる。中身は src/pages/[city]/index.astro
// （本番用・現状は待機中）と完全に同じロジック（src/lib/renderCityPage.ts）
// を使っており、見た目・動作が本物の /shiki/ ・/warabi/ と一致するかどうかを
// ここで確認できる。確認後、本番切り替えの判断に使う想定（確認が済んだら
// このプレビュー用ルート自体は削除してよい）。
import { getAllCityData, renderCityPage } from '../../../lib/renderCityPage';

export async function getStaticPaths() {
  return getAllCityData().map((data) => ({
    params: { city: data.municipality_id },
    props: { data },
  }));
}

const { data } = Astro.props;
const fullHtml = renderCityPage(data);
---
<Fragment set:html={fullHtml} />
