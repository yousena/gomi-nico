---
// src/layouts/BaseLayout.astro
// 共通<head>ボイラープレート（GTM・フォント・OGP・JSON-LD）。
// 既存の public/shiki/index.html 等の<head>から移植。
// 使い方: 各ページで <BaseLayout title="…" description="…" canonicalPath="/shiki/" jsonLd={{...}}>
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** サイトルートからの絶対パス。例: "/shiki/" "/articles/kaden" */
  canonicalPath: string;
  /** JSON-LD構造化データ（@context込みのオブジェクトをそのまま渡す） */
  jsonLd?: Record<string, unknown>;
  /** 自治体ページ用。<meta name="city"> に出力（script.jsが最優先で参照） */
  city?: string;
}

const { title, description, canonicalPath, jsonLd, city } = Astro.props;
const canonicalUrl = new URL(canonicalPath, 'https://gomi-nico.jp').toString();
---
<!DOCTYPE html>
<html lang="ja">
<head>
  <base href="/">
  <!-- Google Tag Manager -->
  <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-MNH8H4L2');</script>
  <!-- End Google Tag Manager -->
  <meta charset="UTF-8">
  {city && <meta name="city" content={city} />}
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">

  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="robots" content="index, follow">
  <link rel="canonical" href={canonicalUrl}>

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="ごみニコ">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:locale" content="ja_JP">

  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>

  {jsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  )}

  <!-- Material Symbols（ナビ用：Outlined / 分別用：Rounded filled） -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20,300,0,0&family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,500,1,0" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20,300,0,0&family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,500,1,0"></noscript>

  <!-- Zen Kaku Gothic New（本文フォント） -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Zen+Kaku+Gothic+New:wght@300;400;500;700;900&display=swap">
</head>
<body class="font-sans">
  <slot />
</body>
</html>
