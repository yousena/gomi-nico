---
// src/layouts/ArticleLayout.astro
// 記事1本ぶんの共通枠（パンくず・ヒーロー・この記事でわかることボックス・目次・
// まとめボックス・関連記事CTA）。中身（本文Markdown）だけがsrc/content/articles/*.mdで差し替わる。
// public/articles/kaden.html の構成・クラス名をそのまま踏襲（DS.md記載のパターン）。
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';

interface Props {
  entry: CollectionEntry<'articles'>;
}

const { entry } = Astro.props;
const { title, description, eyebrow, publishDate, updatedDate, readingMinutes,
        summaryPoints, tags, wrapupTitle, wrapupPoints, wrapupClosing } = entry.data;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);
const canonicalPath = `/articles/${entry.id}`;
const canonicalUrl = new URL(canonicalPath, 'https://gomi-nico.jp').toString();

const dateFmt = (d: Date) => `${d.getFullYear()}年${d.getMonth() + 1}月更新`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: title,
      description,
      image: 'https://gomi-nico.jp/icons/icon-512.png',
      datePublished: publishDate.toISOString().slice(0, 10),
      dateModified: (updatedDate ?? publishDate).toISOString().slice(0, 10),
      inLanguage: 'ja',
      author: { '@type': 'Organization', name: 'ごみニコ', url: 'https://gomi-nico.jp/' },
      publisher: {
        '@type': 'Organization',
        name: '株式会社ユウセナ',
        logo: { '@type': 'ImageObject', url: 'https://gomi-nico.jp/icons/icon-512.png' },
      },
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'ごみニコ', item: 'https://gomi-nico.jp/' },
        { '@type': 'ListItem', position: 2, name: '記事一覧', item: 'https://gomi-nico.jp/articles/' },
        { '@type': 'ListItem', position: 3, name: title, item: canonicalUrl },
      ],
    },
  ],
};
---
<BaseLayout title={`${title} | ごみニコ`} description={description} canonicalPath={canonicalPath} jsonLd={jsonLd}>
  <header class="bg-white border-b border-black/[0.07] sticky top-0 z-10">
    <div class="max-w-2xl mx-auto px-5 py-4 flex items-center gap-3">
      <a href="/articles/" class="text-[#00A86B] font-bold text-sm no-underline">← 前の画面に戻る</a>
    </div>
  </header>

  <main class="bg-white max-w-2xl mx-auto px-5 pt-8 pb-20">
    <nav aria-label="パンくずリスト" class="mb-4">
      <ol class="flex flex-wrap items-center gap-1" style="font-size:12px;color:var(--muted);list-style:none;padding:0;margin:0">
        <li><a href="/" class="no-underline" style="color:var(--muted)">ごみニコ</a></li>
        <li aria-hidden="true">›</li>
        <li><a href="/articles/" class="no-underline" style="color:var(--muted)">記事一覧</a></li>
        <li aria-hidden="true">›</li>
        <li aria-current="page" style="color:var(--ink);font-weight:700">{title}</li>
      </ol>
    </nav>

    <article>
      <div class="flex items-center gap-2 mb-3">
        <span class="tag-chip" style="background:rgba(0,168,107,0.12);color:#00885A;display:inline-flex;align-items:center;border-radius:999px;padding:6px 14px;font-size:13px;font-weight:700">{eyebrow}</span>
      </div>
      <h1 class="mb-3" style="font-family:'Zen Kaku Gothic New',sans-serif;font-size:23px;font-weight:900;color:var(--ink);line-height:1.5;letter-spacing:-.01em">{title}</h1>
      <div class="flex items-center gap-3 mb-5" style="font-size:12px;color:var(--muted)">
        <span class="flex items-center gap-1"><span class="ms-o" style="font-size:14px">calendar_today</span>{dateFmt(updatedDate ?? publishDate)}</span>
        <span class="flex items-center gap-1"><span class="ms-o" style="font-size:14px">schedule</span>読了目安 {readingMinutes}分</span>
      </div>

      <!-- この記事でわかること -->
      <div class="rounded-2xl shadow-sm px-5 py-5 mb-8" style="background:#F3FAF6;border-left:4px solid #00A86B">
        <h2 class="text-[15px] font-extrabold text-[#00885A] mb-3" style="letter-spacing:.08em">この記事でわかること</h2>
        <ul class="flex flex-col gap-2">
          {summaryPoints.map((point) => (
            <li class="flex items-start gap-2" style="font-size:15px;color:#4B4B4D;line-height:1.7">
              <span class="ms" style="font-size:16px;color:#00A86B;flex-shrink:0;margin-top:2px">check_circle</span>
              <span set:html={point} />
            </li>
          ))}
        </ul>
      </div>

      <!-- 目次（h2見出しから自動生成） -->
      <nav aria-label="目次" class="rounded-2xl shadow-sm px-5 py-4 mb-8" style="background:#F0F2F5">
        <h2 class="text-[15px] font-extrabold text-[var(--ink)] mb-3" style="letter-spacing:.08em">目次</h2>
        <ol class="flex flex-col gap-1">
          {toc.map((h, i) => (
            <li>
              <a href={`#${h.slug}`} class="flex items-center gap-2 py-2 text-[15px] font-bold text-[var(--ink)] no-underline">
                <span class="text-[var(--muted)] text-[13px] font-extrabold w-5">{String(i + 1).padStart(2, '0')}</span>
                {h.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>

      <!-- 本文（Markdown） -->
      <div class="article-prose">
        <Content />
      </div>

      <!-- まとめボックス -->
      <div class="rounded-2xl shadow-sm px-5 py-5 mb-8" style="background:#F3FAF6;border-left:4px solid #00A86B">
        <h2 class="text-[15px] font-extrabold text-[#00885A] mb-2" style="letter-spacing:.04em">{wrapupTitle}</h2>
        <ul class="flex flex-col gap-2 mb-3">
          {wrapupPoints.map((wp) => (
            <li class="flex items-start gap-2" style="font-size:15px;color:#4B4B4D;line-height:1.7">
              <span class="ms" style="font-size:16px;color:#00A86B;flex-shrink:0;margin-top:2px">check_circle</span>
              <span>
                <span set:html={wp.label} /><br />
                <span style="font-size:15px;color:#00885A;font-weight:700;margin-top:4px" set:html={wp.action} />
              </span>
            </li>
          ))}
        </ul>
        {wrapupClosing.map((p) => (
          <p class="mb-3" style="font-size:16px;color:#4B4B4D;line-height:1.9" set:html={p} />
        ))}
      </div>

      <div class="flex flex-wrap gap-2 mb-10">
        {tags.map((t) => (
          <span style="display:inline-flex;align-items:center;background:#F0F2F5;color:#4B4B4D;border-radius:999px;padding:6px 14px;font-size:13px;font-weight:700">#{t}</span>
        ))}
      </div>

      <!-- こんな記事も -->
      <div class="mb-10">
        <h2 class="text-[15px] font-extrabold text-[var(--ink)] mb-3" style="letter-spacing:.08em">こんな記事も</h2>
        <div class="flex flex-col gap-3">
          <a href="/articles/" class="flex items-center gap-3 rounded-2xl shadow-sm px-5 py-4 no-underline" style="min-height:44px;background:#F0F2F5">
            <span class="ms" style="font-size:22px;color:#00A86B;flex-shrink:0">menu_book</span>
            <div>
              <p class="text-[15px] font-bold text-[var(--ink)]">記事一覧を見る</p>
              <p class="text-[14px]" style="color:var(--muted)">ごみの困りごとを解決する記事をもっと読む</p>
            </div>
            <span class="ms-o ml-auto" style="font-size:20px;color:var(--muted);flex-shrink:0">chevron_right</span>
          </a>
          <a href="/#cities" class="flex items-center gap-3 rounded-2xl shadow-sm px-5 py-4 no-underline" style="min-height:44px;background:#F0F2F5">
            <span class="ms" style="font-size:22px;color:#00A86B;flex-shrink:0">location_city</span>
            <div>
              <p class="text-[15px] font-bold text-[var(--ink)]">お住まいの自治体のごみ出しアプリを探す</p>
              <p class="text-[14px]" style="color:var(--muted)">収集日の確認・品目検索など、日々使える機能があります</p>
            </div>
            <span class="ms-o ml-auto" style="font-size:20px;color:var(--muted);flex-shrink:0">chevron_right</span>
          </a>
        </div>
      </div>
    </article>
  </main>
</BaseLayout>
