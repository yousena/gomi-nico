  "categories": {
    "moeru": {
      "label": "燃やすごみ",
      "how": "生ごみ・紙くず・木製品・布類・皮革製品・プラスチック製品そのもの等を、地区ごとに決まった週3回（「月・水・金」または「火・木・土」）の朝8時30分までに集積所へ",
      "allowed": [
        "生ごみ（水切りをしてから）、紙くず、紙おむつ（汚物は取り除く）",
        "木製品・木くず（建設廃材を除く）、布類・革製品・ゴム製品",
        "プラスチック製品そのもの（ポリバケツ・CDケース等）、発泡スチロール",
        "1m未満及び20kg未満の木製家具・木製椅子など"
      ],
      "not_allowed": [
        "資源物（ビン・カン・紙類・ペットボトル・布類・白トレー・木くず類は資源物の日へ）",
        "1m以上または20kg以上のもの（粗大ごみへ）",
        "業者処分の品目（石・建築廃材・農業廃材等）"
      ],
      "tips": [
        "収集日は地区で異なり、週3回「月・水・金」または「火・木・土」のいずれか",
        "最も長い部分が1m以上、または重さが20kg以上のものは粗大ごみになります"
      ],
      "how_steps": [
        "指定袋に入れる",
        "地区の収集曜日（週3回）の朝8時30分までに集積所へ"
      ]
    },
    "moenai": {
      "label": "燃やさないごみ",
      "how": "金属製品・ガラス製品・陶磁器・小型家電等を、地区ごとに決まった曜日の毎月第1・3または第2・4の朝8時30分までに集積所へ",
      "allowed": [
        "金属製品（アイロン・なべ・フライパン等）、ガラス製品、陶磁器",
        "小型家電（掃除機・ドライヤー・電卓等）、蛍光灯・電球（中身を確認できる袋に単独で）",
        "乾電池（単独の袋で）、使用済みライター・スプレー缶（中身を使い切ってから）"
      ],
      "not_allowed": [
        "資源物（ビン・カン・紙類・ペットボトル・布類・木くず類は資源物の日へ）",
        "1m以上または20kg以上のもの（粗大ごみへ）",
        "家電4品目・パソコン（別ルートでリサイクル）"
      ],
      "tips": [
        "収集日は地区で異なり、毎月第1・3または第2・4のいずれかの曜日",
        "刃物・ガラスの破片は紙に包んで危険が分かるようにしてください",
        "スプレー缶・ライターは中身を使い切ってから穴を開けずに出してください"
      ],
      "how_steps": [
        "指定袋に入れる（蛍光灯・乾電池は単独の袋で）",
        "地区の収集曜日（月1〜2回）の朝8時30分までに集積所へ"
      ]
    },
    "recycle": {
      "label": "資源物（ビン・カン・紙類・布類・ペットボトル・白トレー）",
      "how": "色別・種類別に分けて資源物回収ステーションへ。地区ごとに決まった曜日の毎月第1・3または第2・4の朝8時30分までに出す。木くず類のみ収集日が異なる",
      "allowed": [
        "ビン（無色透明・茶色・黒色・青緑色の4種に分別、フタを外し中を洗う）",
        "カン（一斗缶までの金属缶、中を洗う）",
        "紙類（新聞紙・ダンボール・雑がみ・紙パック、ひもで縛る）",
        "ペットボトル（識別マークがあるもの、フタ・ラベルを外し軽くすすぐ）",
        "布（シャツ・タオル・着物等、束ねてひもで縛る）",
        "白トレー（真っ白な皿状トレーのみ、洗って乾かす）",
        "木くず類（枝・板、収集日は他の資源物と異なる）"
      ],
      "not_allowed": [
        "化粧品ビン・耐熱ガラス・食器・蛍光灯（燃やさないごみへ）",
        "汚れの落ちないカン・ビン（燃やさないごみへ）",
        "色や柄のついたトレー、匂いのある容器（燃やすごみへ）",
        "羽毛布団・ダウンジャケット・毛布・カーテン・絨毯（布の日には出せません）"
      ],
      "tips": [
        "資源物をごみの収集日に出しても回収されません",
        "ビンは色ごとに正しく分別しないとコンテナごと回収されないことがあります",
        "木くず類の収集日はビン・カン・紙類・ペットボトル・布・白トレーと異なります",
        "廃食用油・ペットボトルキャップはコミュニティセンター等での拠点回収を利用してください"
      ],
      "how_steps": [
        "種類ごとに分別し、洗ってすすぐ",
        "資源物回収ステーションの各コンテナ・回収網袋に入れる",
        "地区の収集曜日の朝8時30分までに出す"
      ]
    },
    "sodai": {
      "label": "粗大ごみ",
      "how": "最も長い部分が1m以上、または重さが20kg以上のごみ。予約制・有料。電話・窓口・市公式LINEで申し込み、1点1,570円の「粗大ごみ処理・廃家電収集運搬券」を販売店等で購入して貼り、毎週水・木曜日の朝8時30分までに指定の場所へ出す",
      "allowed": [
        "家庭から出る粗大ごみ（タンス・ベッド・自転車等）"
      ],
      "not_allowed": [
        "事業活動に伴うごみ",
        "大人2人がかりでも運べない大型のもの、くりーんプラザ・龍に搬入できないもの"
      ],
      "tips": [
        "収集は毎週水・木曜日の予約制です（LINE・窓口・電話0297-64-1111で予約）",
        "「くりーんプラザ・龍」への直接搬入（有料）も可能です",
        "リユースプラットフォーム「おいくら」での売却も検討できます",
        "手数料は還付できません"
      ],
      "how_steps": [
        "LINE・窓口・電話で予約する",
        "「粗大ごみ処理・廃家電収集運搬券」（1点1,570円）を販売店等で購入し氏名を記入して貼る",
        "指定収集日の朝8時30分までに指定の場所へ出す"
      ]
    },
    "unknown": {
      "label": "業者処分・収集できないごみ（家電4品目・パソコン等）",
      "how": "家電4品目（エアコン・テレビ・冷蔵庫冷凍庫・洗濯機）は購入した販売店またはメーカーへ、パソコンはメーカーまたはリサイクル窓口へ、その他業者処分の品目は専門の処理業者へ依頼してください",
      "allowed": [],
      "not_allowed": [
        "家電4品目（テレビ・エアコン・冷蔵庫冷凍庫・洗濯機衣類乾燥機）",
        "パソコン、バイク、消火器",
        "建築廃材、コンクリート、石、農薬・農機具、シンナー・ガソリン等の危険物",
        "水銀使用の体温計・温度計（くりーんプラザ・龍への直接搬入のみ）"
      ],
      "tips": [
        "家電4品目は家電リサイクル法の対象で、購入した販売店またはメーカーへ引き取りを依頼してください",
        "パソコンは資源有効利用促進法によりメーカーへ（パソコンの出し方のページ参照）",
        "消火器は消火器リサイクル推進センターへ",
        "水銀使用の体温計・温度計はくりーんプラザ・龍への直接搬入のみ受付"
      ],
      "how_steps": [
        "品目を確認し該当する処分方法を選ぶ",
        "販売店・メーカー・専門業者に連絡する",
        "案内に従って処分する"
      ]
